# --- Core ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://energy:energy_dev_password@localhost:5436/energy_calculator?schema=public"

# --- Redis (cache + BullMQ queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Object storage (MinIO locally, S3/R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=energy_minio
S3_SECRET_KEY=energy_minio_password
S3_BUCKET=energy-app
S3_FORCE_PATH_STYLE=true

# --- Integrations (all optional — mock providers are used when absent) ---
# Free, keyless / demo-key APIs wired for real:
NREL_API_KEY=DEMO_KEY
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Paid integrations — leave blank to use mock providers:
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
POSTMARK_SERVER_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENTRY_DSN=
POSTHOG_API_KEY=
